---
import Layout from '../layouts/Layout.astro';
import VineFrame from '../components/VineFrame.astro';
import PetalField from '../components/PetalField.astro';
---
<Layout title="Shri — Begin the Journey">
  <main class="gateway">
    <div class="paper-texture" aria-hidden="true"></div>
    <VineFrame />
    <div class="glow" aria-hidden="true"></div>
    <PetalField />

    <div class="gateway-content">
      <h1 class="title-sanskrit">श्रीमद्भागवतम्</h1>

      <p class="creators">
        <span>SRINIVAS</span>
        <span class="dot">—</span>
        <span>CHAHAT</span>
        <span class="dot">—</span>
        <span>KUNAL</span>
      </p>

      <p class="question">Are you ready for the journey?</p>

      <a class="cta" href="/library/">Begin your sacred journey</a>
    </div>
  </main>
</Layout>

<style>
  /* Sequence, in order: title rises and stays -> names fade in together ->
     question fades in -> petals fall and settle -> CTA glows in. Every
     delay below is tuned relative to the step before it, so changing one
     timing number shifts everything after it — adjust top to bottom. */

  .gateway {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: radial-gradient(
      ellipse at 50% 35%,
      var(--color-parchment-deep) 0%,
      var(--color-parchment) 60%
    );
  }

  .paper-texture {
    position: absolute;
    inset: 0;
    opacity: 0.6;
    mix-blend-mode: multiply;
    pointer-events: none;
    background-image: radial-gradient(circle at 20% 30%, rgba(184, 132, 47, 0.05), transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(107, 87, 68, 0.06), transparent 45%),
      repeating-linear-gradient(
        0deg,
        rgba(58, 42, 30, 0.015) 0px,
        rgba(58, 42, 30, 0.015) 1px,
        transparent 1px,
        transparent 3px
      );
  }

  .glow {
    position: absolute;
    top: 30%;
    left: 50%;
    width: 60vw;
    height: 60vw;
    max-width: 640px;
    max-height: 640px;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(184, 132, 47, 0.22) 0%, rgba(184, 132, 47, 0) 70%);
    animation: breathe 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }

  .gateway-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem;
    max-width: 40rem;
  }

  /* Step 1 — Sanskrit title rises from below and remains visible */
  .title-sanskrit {
    font-family: var(--font-sanskrit);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    color: var(--color-ink);
    margin: 0 0 2rem;
    opacity: 0;
    transform: translateY(28px);
    animation: rise-and-stay 1.8s cubic-bezier(0.22, 0.6, 0.32, 1) 0.3s forwards;
  }

  /* Step 2 — the three names, together */
  .creators {
    margin: 0 0 2.5rem;
    font-size: 0.95rem;
    letter-spacing: 0.14em;
    color: var(--color-ink-soft);
    opacity: 0;
    animation: fade-in 1.4s ease-out 2.1s forwards;
  }

  .creators .dot {
    margin: 0 0.6em;
    color: var(--color-gold);
  }

  /* Step 3 — the question */
  .question {
    font-style: italic;
    font-size: 1.25rem;
    color: var(--color-ink);
    margin: 0 0 3rem;
    opacity: 0;
    animation: fade-in 1.4s ease-out 3.4s forwards;
  }

  /* Step 4 — petals fall (see PetalField.astro; its delays start at 4.4s,
     after the question above has appeared) */

  /* Step 5 — the CTA glows in once the petals have settled */
  .cta {
    display: inline-block;
    padding: 0.9rem 2.2rem;
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    color: var(--color-ink);
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    text-decoration: none;
    opacity: 0;
    animation: glow-in 1.6s ease-out 6.6s forwards;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }

  .cta:hover {
    box-shadow: 0 0 24px rgba(184, 132, 47, 0.35);
    transform: translateY(-1px);
  }

  @keyframes rise-and-stay {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes glow-in {
    0% {
      opacity: 0;
      box-shadow: 0 0 0 rgba(184, 132, 47, 0);
    }
    100% {
      opacity: 1;
      box-shadow: 0 0 18px rgba(184, 132, 47, 0.2);
    }
  }

  /* Step 6 — clicking .cta navigates to /library/, a plain <a> link,
     no JS required */

  @media (prefers-reduced-motion: reduce) {
    .title-sanskrit,
    .creators,
    .question,
    .cta,
    .glow {
      animation: none;
      opacity: 1;
      transform: none;
      box-shadow: none;
    }
  }
</style>
