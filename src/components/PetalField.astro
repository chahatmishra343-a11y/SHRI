---
interface Petal {
  id: number;
  size: number;
  left: number;
  restTop: number;
  rotation: number;
  delay: number;
  duration: number;
  direction: 'left' | 'right' | 'top';
}

// Deterministic pseudo-random values (not Math.random()) so every build
// produces the same layout — makes the animation easy to tune and review,
// rather than looking different on every reload.
function seeded(seed: number) {
  const x = Math.sin(seed * 999) * 10000;
  return x - Math.floor(x);
}

const directions: Petal['direction'][] = ['left', 'right', 'top'];
const petalCount = 9;

const petals: Petal[] = Array.from({ length: petalCount }, (_, i) => {
  const r1 = seeded(i + 1);
  const r2 = seeded(i + 20);
  const r3 = seeded(i + 40);
  const r4 = seeded(i + 60);
  return {
    id: i,
    size: 30 + Math.round(r1 * 24), // 30–54px — larger petals, per the brief
    left: Math.round(r2 * 88) + 4, // 4–92vw
    restTop: Math.round(r3 * 42) + 8, // where each petal settles, in vh
    rotation: Math.round(r4 * 360),
    delay: 4.4 + r1 * 1.8, // petals begin after the question has appeared
    duration: 3.2 + r2 * 1.6,
    direction: directions[i % directions.length],
  };
});
---
<div class="petal-field" aria-hidden="true">
  {
    petals.map((p) => (
      <span
        class={`petal petal--from-${p.direction}`}
        style={`--size:${p.size}px; --left:${p.left}vw; --rest-top:${p.restTop}vh; --rot:${p.rotation}deg; --delay:${p.delay}s; --duration:${p.duration}s;`}
      >
        <svg viewBox="0 0 40 56" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id={`petalGrad${p.id}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#e9c06a" />
              <stop offset="55%" stop-color="#c9973f" />
              <stop offset="100%" stop-color="#9c6f22" />
            </linearGradient>
          </defs>
          <path
            d="M20 2C28 12 36 24 36 34C36 46 29 54 20 54C11 54 4 46 4 34C4 24 12 12 20 2Z"
            fill={`url(#petalGrad${p.id})`}
          />
          <path d="M20 8C20 8 20 30 20 50" stroke="#8a5f1c" stroke-width="0.6" opacity="0.4" fill="none" />
        </svg>
      </span>
    ))
  }
</div>

<style>
  .petal-field {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .petal {
    position: absolute;
    top: 0;
    left: var(--left);
    width: var(--size);
    height: calc(var(--size) * 1.4);
    opacity: 0;
    filter: drop-shadow(0 6px 10px rgba(58, 42, 30, 0.18));
    animation-name: settle;
    animation-duration: var(--duration);
    animation-delay: var(--delay);
    animation-timing-function: cubic-bezier(0.25, 0.6, 0.3, 1);
    animation-fill-mode: forwards;
  }

  .petal svg {
    width: 100%;
    height: 100%;
    transform: rotate(var(--rot));
  }

  .petal--from-left {
    transform: translate(-32vw, -12vh) rotate(calc(var(--rot) - 40deg));
  }
  .petal--from-right {
    transform: translate(32vw, -12vh) rotate(calc(var(--rot) + 40deg));
  }
  .petal--from-top {
    transform: translate(0, -32vh) rotate(var(--rot));
  }

  @keyframes settle {
    0% {
      opacity: 0;
    }
    18% {
      opacity: 0.95;
    }
    100% {
      opacity: 0.9;
      transform: translate(0, var(--rest-top)) rotate(var(--rot));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .petal {
      animation: none;
      opacity: 0.85;
      transform: translate(0, var(--rest-top)) rotate(var(--rot));
    }
  }
</style>
